# Copia a .env y rellena. NUNCA subas .env a git.
# RPC privado recomendado (Helius, QuickNode, Triton...). El público tiene límites muy bajos.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_KEY
# Clave gratuita en portal.jup.ag (solo necesaria en modo live)
JUPITER_API_KEY=
# Clave privada en base58 de un wallet DEDICADO al bot, con solo el capital que puedes perder
WALLET_PRIVATE_KEY=
# Opcional: avisos por Telegram (@BotFather para el token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Panel web: obligatorio si lo expones fuera de localhost (por ejemplo, en Docker). Pon algo largo y aleatorio.
DASHBOARD_TOKEN=
# Actualizaciones automáticas: token de GitHub de SOLO LECTURA (Contents: Read-only) del repositorio
GITHUB_TOKEN=
# Analista Claude (opcional, de pago por uso): console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
